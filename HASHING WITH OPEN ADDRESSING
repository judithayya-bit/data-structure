#include <stdio.h>

#define SIZE 10

int hashTable[SIZE];

void insert(int key)
{
    int index, i;

    index = key % SIZE;

    for(i = 0; i < SIZE; i++)
    {
        int pos = (index + i) % SIZE;

        if(hashTable[pos] == -1)
        {
            hashTable[pos] = key;
            return;
        }
    }

    printf("Hash table is full!\n");
}

void display()
{
    int i;

    printf("\nHash Table:\n");

    for(i = 0; i < SIZE; i++)
    {
        if(hashTable[i] == -1)
            printf("%d : Empty\n", i);
        else
            printf("%d : %d\n", i, hashTable[i]);
    }
}

int main()
{
    int n, key, i;

    for(i = 0; i < SIZE; i++)
        hashTable[i] = -1;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter elements:\n");

    for(i = 0; i < n; i++)
    {
        scanf("%d", &key);
        insert(key);
    }

    display();

    return 0;
}
```

### Example

**Input:**

```
5
10 20 25 35 15
```

**Output:**

```
Hash Table:
0 : 10
1 : 20
2 : Empty
3 : 35
4 : 25
5 : 15
6 : Empty
7 : Empty
8 : Empty
9 : Empty
```

### Key point

Hash function:

```
h(key) = key % 10
```

If the calculated position is already occupied, **linear probing** checks the next position:

```
(index + 1) % SIZE
``
