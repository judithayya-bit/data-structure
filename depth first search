
#include <stdio.h>

int graph[10][10], visited[10], n;

void DFS(int v)
{
    int i;

    printf("%d ", v);
    visited[v] = 1;

    for(i = 0; i < n; i++)
    {
        if(graph[v][i] == 1 && visited[i] == 0)
        {
            DFS(i);
        }
    }
}

int main()
{
    int i, j, start;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter adjacency matrix:\n");
    for(i = 0; i < n; i++)
        for(j = 0; j < n; j++)
            scanf("%d", &graph[i][j]);

    printf("Enter starting vertex: ");
    scanf("%d", &start);

    printf("DFS: ");
    DFS(start);

    return 0;
}
```

### Example Output

```
Enter number of vertices: 5

Enter starting vertex: 0

DFS: 0 1 3 4 2
```

**Difference:**

- **BFS** → uses **Queue**
- **DFS** → uses **Recursion / Stack**
